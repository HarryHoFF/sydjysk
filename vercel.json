{
  "rewrites": [
    { "source": "/((?!_expo|assets|icon-|apple-touch|favicon|manifest|sw).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
